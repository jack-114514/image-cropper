{
  "name": "image-cropper",
  "version": "0.2.0",
  "description": "Ready-to-use React image cropping for avatars, covers and responsive website images.",
  "license": "MIT",
  "author": "jack-114514",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-114514/image-cropper.git"
  },
  "homepage": "https://github.com/jack-114514/image-cropper#readme",
  "bugs": {
    "url": "https://github.com/jack-114514/image-cropper/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "image",
    "cropper",
    "avatar",
    "cover",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test": "node --experimental-strip-types --test tests/geometry.test.ts tests/i18n.test.ts",
    "test:e2e": "playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "react-advanced-cropper": "0.20.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
